# Copy this file to .env.local and fill in the values from your Firebase
# project's Web App config (Firebase console -> Project settings -> General
# -> Your apps -> SDK setup and configuration).
#
# These values are not secret (they identify the project, not authorize
# access) but are kept out of the repo so each environment can point at its
# own Firebase project without editing tracked files.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to "true" to point the app at a local
# `firebase emulators:start` instead of your real project (e.g. for testing
# without touching real data). Leave unset/false for normal use.
VITE_USE_FIREBASE_EMULATOR=false
